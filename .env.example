# Copy to .env and restart the server after changing configuration.
RAG_HOST=127.0.0.1
RAG_PORT=8000
# Set to true behind HTTPS. For local HTTP leave false.
RAG_COOKIE_SECURE=false
# Blank generates a random password saved once in data/bootstrap-admin.txt.
# Only used when creating the first account in a NEW database.
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD=
# DeepSeek-compatible endpoint. Model ID must match your provider's actual API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Example used during development. Confirm the ID against your provider's model list.
DEEPSEEK_MODEL=deepseek-flash
# local: install requirements-local-model.txt; first indexing downloads BAAI/bge-m3.
# api: configure an OpenAI-compatible /embeddings endpoint serving bge-m3.
BGE_MODE=local
BGE_MODEL=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_BASE_URL=http://127.0.0.1:8001/v1
BGE_API_KEY=
# Optional data directory; leave commented to use ./data under the project.
# RAG_DATA_DIR=./data
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=120
RAG_MAX_UPLOAD_MB=20
RAG_MAX_AGENT_ROUNDS=3
